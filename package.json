{
  "name": "digifeel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:legacy": "vite --config vite.legacy.config.ts --port=3002 --host=0.0.0.0",
    "api": "tsx server/index.ts",
    "build": "next build",
    "build:cloudflare": "npm run build:vinext",
    "preview:cloudflare": "npm run start:vinext",
    "deploy:cloudflare": "npm run deploy:vinext",
    "build:legacy": "vite build --config vite.legacy.config.ts",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "preview:legacy": "vite preview --config vite.legacy.config.ts --host=0.0.0.0",
    "clean:legacy": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "cross-env LOAD=1 vitest run tests/load"
  },
