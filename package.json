{
  "name": "digifeel",
  "private": true,
  "version": "1.0.0",
  "description": "Logiciel de gestion pour restaurants",
  "author": "Digifeel",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "portfolio:build": "tsx scripts/generate-portfolio.mts public/portfolio-files",
    "test:load": "cross-env LOAD=1 vitest run tests/load",
    "desktop:dev": "cross-env DIGIFEEL_APP_URL=http://localhost:3000 electron .",
    "dist:win": "node scripts/prepare-electron.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^14.1.1",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "fr.digifeel.app",
    "productName": "Digifeel",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/sax/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/buffer-crc32/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Digifeel",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "abdou5536",
      "repo": "digifeel",
      "releaseType": "release"
    }
  }
}
