# Application and API
DATABASE_URL=postgresql://user:password@localhost:5432/digifeel
APP_ORIGIN=http://localhost:3000
PORT=3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional, used only by the server-side review-reply suggestion route.
GEMINI_API_KEY=
ACTIVATION_CODE_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
RATE_LIMIT_PEPPER=replace-with-a-different-random-secret-of-at-least-32-characters
AUTH_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-secret
# Set only behind a trusted reverse proxy; value is the exact proxy hop count.
# TRUST_PROXY_HOPS=1

# Stripe test mode only. Stripe webhook secret for Supabase Edge Functions is configured with
# `supabase secrets set STRIPE_WEBHOOK_SECRET=...`; this local variable is retained for Express.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional email (invites and payment notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional manual payments; CCP_EUR_TO_DZD is required before CCP checkout is enabled.
CCP_ACCOUNT_NAME=
CCP_ACCOUNT_NUMBER=
CCP_KEY=
BARIDIMOB_RIP=
BARIDIMOB_PHONE=
CCP_EUR_TO_DZD=

# Keep uploads outside public/ and back up the directory securely.
# PAYMENT_PROOF_DIR=private-uploads

# --- Exploitation (voir DEPLOIEMENT.md) ---
# Un fichier par environnement : .env.local (développement, données fictives uniquement),
# variables "Preview" Cloudflare (test), variables "Production" Cloudflare. Ne jamais copier la prod en dev.
# Mettre à 0 pour masquer les pages historiques utilisant localStorage en développement.
# Ces routes renvoient toujours 404 en production, même si la valeur est à 1.
ENABLE_LOCAL_WORKSPACE=
# Sauvegardes (scripts/backup.mjs) : connexion directe base, dossier hors projet, clé AES (openssl rand -base64 32)
BACKUP_DB_URL=
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=