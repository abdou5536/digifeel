# Copiez ce fichier en ".env" (local) ou renseignez ces variables dans Vercel. Ne commitez JAMAIS .env.

# ---- OBLIGATOIRES ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-public
# Cle secrete "service_role" : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_remplacez-moi
# Deux secrets aleatoires differents, 32 caracteres minimum (ex : openssl rand -base64 32)
ACTIVATION_CODE_PEPPER=remplacez-par-un-secret-aleatoire-de-32-caracteres-min
RATE_LIMIT_PEPPER=remplacez-par-un-autre-secret-aleatoire-de-32-caracteres
# Adresse publique du site (sans slash final)
APP_ORIGIN=http://localhost:3000
AUTH_BOOTSTRAP_TOKEN=remplacez-par-un-long-secret-aleatoire

# ---- OPTIONNELLES ----
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Derriere un proxy de confiance uniquement : nombre de sauts
# TRUST_PROXY_HOPS=1
# Pages historiques en localStorage (toujours 404 en production)
ENABLE_LOCAL_WORKSPACE=

# Paiements / emails (non necessaires pour la demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CCP_ACCOUNT_NAME=
CCP_ACCOUNT_NUMBER=
CCP_KEY=
BARIDIMOB_RIP=
BARIDIMOB_PHONE=
CCP_EUR_TO_DZD=

# Sauvegardes (scripts/backup.mjs)
BACKUP_DB_URL=
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=